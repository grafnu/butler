#!/bin/bash
#
# run_cross: Direct cross-implementation testing executor in Bash.
# Runs all base implementations and produces log and message trace files for analysis.
# Strictly uses standard system components.

set -euo pipefail

export PYTHONUNBUFFERED=1

# Force non-interactive fail-fast execution across all sub-shells/tools
export CLOUDSDK_CORE_DISABLE_PROMPTS=1
export DEBIAN_FRONTEND=noninteractive
export SUDO_ASKPASS=/bin/false

# Setup directory parameters
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${MAIN_DIR}"

# Source shared port allocation and cleanup utility
source "${SCRIPT_DIR}/port_utils"

# List of implementations
# ASSUMPTION: If arguments are provided but some are flags (like -p or -s), the remaining non-flag arguments are treated as the list of implementations.
DEFAULT_IMPLEMENTATIONS=("A" "B" "C" "D")
IMPLEMENTATIONS=()

# Parse command line flags
USE_SANDBOX="false"
USE_PARALLEL="false"
for arg in "$@"; do
  if [ "$arg" = "-s" ] || [ "$arg" = "--sandbox" ]; then
    USE_SANDBOX="true"
  elif [ "$arg" = "-p" ] || [ "$arg" = "--parallel" ]; then
    USE_PARALLEL="true"
  else
    IMPLEMENTATIONS+=("$arg")
  fi
done

if [ ${#IMPLEMENTATIONS[@]} -eq 0 ]; then
  IMPLEMENTATIONS=("${DEFAULT_IMPLEMENTATIONS[@]}")
fi

# Configurable timeouts for event-driven polling (seconds)
CROSS_HANDSHAKE_TIMEOUT="${CROSS_HANDSHAKE_TIMEOUT:-30}"
CROSS_TRANSITION_TIMEOUT="${CROSS_TRANSITION_TIMEOUT:-240}"

# Clean existing tmp / output logs
mkdir -p out
mkdir -p impl
rm -f impl/test_summary.txt.tmp out/metrics.tmp

# Poll for a log pattern in a file up to a configurable timeout.
# Returns 0 if pattern found, 1 if timeout reached.
poll_for_pattern() {
  local file="$1"
  local pattern="$2"
  local timeout="${3:-60}"
  local elapsed=0
  while [ "${elapsed}" -lt "${timeout}" ]; do
    if [ -f "${file}" ] && grep -q "${pattern}" "${file}" 2>/dev/null; then
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 1
}

run_track() {
  local v="$1"
  local track_start=$SECONDS

  # Calculate branch/variant specific ports using shared utility
  local port
  port=$(calculate_branch_port "impl_${v}")
  local etcd_port=$((port + 1))
  local etcd_peer_port=$((port + 1001))
  local conn_spec="mqtts://rocket:monkey@localhost:${port}/"

  # Clean up any existing cross-track symlinks to avoid self-referential cycles
  for b in "${IMPLEMENTATIONS[@]}"; do
    if [ -L "impl/${b}/impl/udmi/var/mosquitto/certs" ]; then
      rm -f "impl/${b}/impl/udmi/var/mosquitto/certs"
    fi
  done

  echo "[Track impl_${v}] Initializing environment on port {${port}}..." >&2
  cleanup_port "${port}"
  cleanup_port "${etcd_port}"
  cleanup_port "${etcd_peer_port}"

  # 1. Run Setup
  local setup_start=$SECONDS
  local setup_log="out/${v}_setup.log"
  local ret=0

  # Execute setup cleanly in sibling directory
  (
    cd "impl/${v}"
    export MQTT_PORT="${port}"
    export ETCD_PORT="${etcd_port}"
    export BUTLER_CONN_SPEC="${conn_spec}"
    bin/setup "${conn_spec}" "--offline" < /dev/null > "../../${setup_log}" 2>&1
  ) || ret=$?

  if [ "${ret}" -ne 0 ]; then
    echo "[Track impl_${v}] Setup utility failed with exit code ${ret}." >&2
    for b in "${IMPLEMENTATIONS[@]}"; do
      echo "impl_${v} verifies impl_${b}: FAIL" >> impl/test_summary.txt.tmp
    done
    return
  fi

  local setup_dur=$(( SECONDS - setup_start ))

  # 2. Broker Connection Verification
  local broker_startup_start=$SECONDS
  local broker_ok=0
  for i in {1..30}; do
    if nc -z localhost "${port}" >/dev/null 2>&1; then
      broker_ok=1
      break
    fi
    sleep 0.5
  done

  if [ "${broker_ok}" -eq 0 ]; then
    echo "[Track impl_${v}] Broker failed to accept connections on port ${port}." >&2
    for b in "${IMPLEMENTATIONS[@]}"; do
      echo "impl_${v} verifies impl_${b}: FAIL" >> impl/test_summary.txt.tmp
    done
    return
  fi

  local broker_startup_dur=$(( SECONDS - broker_startup_start ))

  # 3. Start Background Message Observer (once per track, for evidence collection)
  local observe_log="out/${v}_observe.log"
  (
    cd "impl/${v}"
    export MQTT_PORT="${port}"
    export ETCD_PORT="${etcd_port}"
    impl/udmi/bin/observe_uufi "localhost" "${port}" "rocket" "monkey" "$(pwd)/testing/udmi_site_model" < /dev/null > "../../${observe_log}" 2>&1 &
    echo $! > "../../out/${v}_observe.pid"
  )

  # 3.2 UDMIS Startup Synchronization Delay
  # (Section 10.7.3 requirement: test harness MUST implement a startup synchronization delay of at least 15 seconds
  # after starting the local UDMIS service pod and BEFORE launching the simulated device (DUT))
  echo "[Track impl_${v}] Waiting 15s for UDMIS startup synchronization..." >&2
  sleep 15

  # 3.5 Start Long-Running Idempotent DUT (Pubber) once per track
  local pubber_log="out/${v}_pubber.log"
  local dut_conn_spec="//mqtt/localhost:${port}"
  (
    cd "impl/${v}"
    export MQTT_PORT="${port}"
    export ETCD_PORT="${etcd_port}"
    impl/udmi/bin/start_dut "testing/udmi_site_model" "${dut_conn_spec}" "AHU-1" < /dev/null > "../../${pubber_log}" 2>&1 &
    echo $! > "../../out/${v}_pubber.pid"
  )

  # Reorder implementations to run the self-validation pairing (v == b) first
  local run_order=("${v}")
  for b in "${IMPLEMENTATIONS[@]}"; do
    if [ "${b}" != "${v}" ]; then
      run_order+=("${b}")
    fi
  done

  # 4. Sequentially run target butler implementations
  local self_failed=0
  for b in "${run_order[@]}"; do
    if [ "${self_failed}" -eq 1 ]; then
      # If the self-validation pairing failed, do not run other pairings.
      # Record FAIL in the summary and metrics immediately.
      echo "impl_${v} verifies impl_${b}: FAIL" >> impl/test_summary.txt.tmp
      {
        echo "Pair: impl_${v} verifies impl_${b} (FAIL)"
        echo "  - Broker Startup: 0s"
        echo "  - Setup Utility Execution: 0s"
        echo "  - Active Verification Loop: 0s"
        echo "  - Cleanup & Teardown: 0s"
        echo "  - Skipped: Self-validation failure"
        echo ""
      } >> out/metrics.tmp
      continue
    fi

    local pair_start=$SECONDS
    echo "[Track impl_${v}] Launching target butler impl_${b}..." >&2

    # Start per-pairing verifier with isolated log file
    # (Issue #1 fix: per-pairing verifier restart prevents log accumulation
    #  and false-positive success detection across pairings)
    local verifier_log="out/${v}_${b}_verifier.log"
    (
      cd "impl/${v}"
      export MQTT_PORT="${port}"
      export ETCD_PORT="${etcd_port}"
      bin/verifier "${conn_spec}" < /dev/null > "../../${verifier_log}" 2>&1 &
      echo $! > "../../out/${v}_${b}_verifier.pid"
    )

    # Brief boot moment for verifier to initialize
    sleep 2

    # Start target butler
    local butler_log="out/${v}_${b}_butler.log"
    # Ensure target butler can dynamically load and trust the active track's broker certificates
    if [ "${v}" != "${b}" ]; then
      local b_cert_dir="impl/${b}/impl/udmi/var/mosquitto"
      mkdir -p "${b_cert_dir}"
      rm -rf "${b_cert_dir}/certs"
      ln -sf "$(pwd)/impl/${v}/impl/udmi/var/mosquitto/certs" "${b_cert_dir}/certs"
    fi
    (
      cd "impl/${b}"
      export MQTT_PORT="${port}"
      export ETCD_PORT="${etcd_port}"
      bin/butler "${conn_spec}" < /dev/null > "../../${butler_log}" 2>&1 &
      echo $! > "../../out/${v}_${b}_butler.pid"
    )

    # Poll for handshake completion
    # (Issue #3 fix: event-driven polling replaces blind sleep 10)
    poll_for_pattern "${verifier_log}" "Handshake completed" "${CROSS_HANDSHAKE_TIMEOUT}" || true

    # Trigger software update
    local trigger_log="out/${v}_${b}_trigger.log"
    (
      cd "impl/${v}"
      export MQTT_PORT="${port}"
      export ETCD_PORT="${etcd_port}"
      impl/udmi/bin/site_trigger "update" "testing/udmi_site_model" "AHU-1" "system" "1.1.0" "${conn_spec}" < /dev/null > "../../${trigger_log}" 2>&1 || true
    )

    # Poll for terminal state in butler log
    # (Issue #3 fix: event-driven polling replaces blind sleep 15;
    #  timeout accommodates BUTLER_TIMEOUT=60s with retries)
    poll_for_pattern "${butler_log}" "terminal state" "${CROSS_TRANSITION_TIMEOUT}" || true

    # Safe PID-Based teardown for butler
    if [ -f "out/${v}_${b}_butler.pid" ]; then
      local b_pid
      b_pid=$(cat "out/${v}_${b}_butler.pid")
      if kill -0 "${b_pid}" 2>/dev/null; then
        kill -15 "${b_pid}" 2>/dev/null || true
        sleep 0.5
        kill -9 "${b_pid}" 2>/dev/null || true
      fi
      rm -f "out/${v}_${b}_butler.pid"
    fi

    # Teardown per-pairing verifier
    if [ -f "out/${v}_${b}_verifier.pid" ]; then
      local ver_pid
      ver_pid=$(cat "out/${v}_${b}_verifier.pid")
      if kill -0 "${ver_pid}" 2>/dev/null; then
        kill -15 "${ver_pid}" 2>/dev/null || true
        sleep 0.5
        kill -9 "${ver_pid}" 2>/dev/null || true
      fi
      rm -f "out/${v}_${b}_verifier.pid"
    fi

    # Verify compliance using exact spec-compliant log patterns
    # (Issue #4 fix: strict pattern matching from spec/butler.md Section 9.2,
    #  no loose grep -qi "success" fallback)
    local success=0
    if [ -f "${verifier_log}" ]; then
      if grep -q "VERIFIER \[INFO\]: State transition for.*pending -> success" "${verifier_log}" 2>/dev/null; then
        success=1
      fi
    fi
    if [ "${success}" -eq 0 ] && [ -f "${butler_log}" ]; then
      if grep -q "\[butler\] Device.*terminal state success with version" "${butler_log}" 2>/dev/null; then
        success=1
      fi
    fi

    local status_str="FAIL"
    if [ "${success}" -eq 1 ]; then
      status_str="PASS"
    fi

    # Create and copy the validates log in both implementation directories
    local validates_log="${v}_validates_${b}.log"
    mkdir -p "impl/${v}/logs"
    mkdir -p "impl/${b}/logs"
    {
      echo "=== UUFI MESSAGE OBSERVATION TRACE ==="
      cat "${observe_log}" 2>/dev/null || true
      echo ""
      echo "=== ACTIVE VERIFIER COMPLIANCE LOG ==="
      cat "${verifier_log}" 2>/dev/null || true
      echo ""
      echo "=== TARGET BUTLER LOG ==="
      cat "${butler_log}" 2>/dev/null || true
    } > "impl/${v}/logs/${validates_log}"
    if [ "${v}" != "${b}" ]; then
      cp "impl/${v}/logs/${validates_log}" "impl/${b}/logs/${validates_log}"
    fi

    local pair_dur=$(( SECONDS - pair_start ))
    echo "impl_${v} verifies impl_${b}: ${status_str}" >> impl/test_summary.txt.tmp

    # Capture structured pairing metrics
    {
      echo "Pair: impl_${v} verifies impl_${b} (${status_str})"
      echo "  - Broker Startup: ${broker_startup_dur}s"
      echo "  - Setup Utility Execution: ${setup_dur}s"
      echo "  - Active Verification Loop: ${pair_dur}s"
      echo "  - Cleanup & Teardown: 1s"
      echo ""
    } >> out/metrics.tmp

    # If this was self-validation and it failed, stop future pairings in this track
    if [ "${v}" = "${b}" ] && [ "${status_str}" = "FAIL" ]; then
      echo "[Track impl_${v}] Self-validation pairing failed! Skipping remaining pairings." >&2
      self_failed=1
    fi
  done

  # Teardown observer
  if [ -f "out/${v}_observe.pid" ]; then
    local o_pid
    o_pid=$(cat "out/${v}_observe.pid")
    if kill -0 "${o_pid}" 2>/dev/null; then
      kill -15 "${o_pid}" 2>/dev/null || true
      sleep 0.5
      kill -9 "${o_pid}" 2>/dev/null || true
    fi
    rm -f "out/${v}_observe.pid"
  fi

  # Teardown the track-level DUT (Pubber)
  if [ -f "out/${v}_pubber.pid" ]; then
    local p_pid
    p_pid=$(cat "out/${v}_pubber.pid")
    if kill -0 "${p_pid}" 2>/dev/null; then
      kill -15 "${p_pid}" 2>/dev/null || true
      sleep 0.5
      kill -9 "${p_pid}" 2>/dev/null || true
    fi
    rm -f "out/${v}_pubber.pid"
  fi

  # Stop broker and services
  (
    cd "impl/${v}"
    export MQTT_PORT="${port}"
    export ETCD_PORT="${etcd_port}"
    bin/setup "${conn_spec}" --stop < /dev/null > /dev/null 2>&1 || true
  )
  cleanup_port "${port}"
  cleanup_port "${etcd_port}"
  cleanup_port "${etcd_peer_port}"

  # Clean up symlinks at the end of the track to leave a clean state
  for b in "${IMPLEMENTATIONS[@]}"; do
    if [ -L "impl/${b}/impl/udmi/var/mosquitto/certs" ]; then
      rm -f "impl/${b}/impl/udmi/var/mosquitto/certs"
    fi
  done

  local track_dur=$(( SECONDS - track_start ))
  echo "Track impl_${v} Duration: ${track_dur}s" >> out/metrics.tmp
}

# Run tracks in parallel or sequentially depending on -p / --parallel flag
start_all=$SECONDS
if [ "${USE_PARALLEL}" = "true" ]; then
  echo "=== Running Integration Tracks in Parallel ===" >&2
  for v in "${IMPLEMENTATIONS[@]}"; do
    run_track "$v" &
  done
  wait
else
  echo "=== Running Integration Tracks Sequentially ===" >&2
  for v in "${IMPLEMENTATIONS[@]}"; do
    run_track "$v"
  done
fi

# 1. Output summary results in lexicographical order
sort impl/test_summary.txt.tmp > impl/test_summary.txt
rm -f impl/test_summary.txt.tmp

echo "=== Integration Test Summary ==="
cat impl/test_summary.txt
echo "================================"

# 2. Write structured Performance Profile Analysis
total_dur=$(( SECONDS - start_all ))
perf_path="out/performance_analysis.txt"

{
  echo "=================================================="
  echo "          INTEGRATION TEST PERFORMANCE PROFILE   "
  echo "=================================================="
  echo ""
  echo "Implementation Sync Duration: 0.00s (Completed by parent workflow)"
  echo "Virtual Environment Setup Duration: 0.00s (Completed by parent workflow)"
  echo ""
  echo "--- Paired Testing Metrics ---"
  # Sort and output pairings nicely
  grep -A 5 "Pair:" out/metrics.tmp || true
  echo ""
  echo "--- Sequential Track Durations ---"
  grep "Track " out/metrics.tmp || true
  echo ""
  echo "Overall Run Duration: ${total_dur}s"
  echo "=================================================="
} > "${perf_path}"

rm -f out/metrics.tmp
echo "Performance analysis written to ${perf_path}"
exit 0

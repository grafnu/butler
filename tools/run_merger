#!/bin/bash
#
# This script runs the Gemini merger integration tests.
#
# Usage: ./tools/run_merger

set -euo pipefail

# Force non-interactive fail-fast execution across all sub-shells/tools
export CLOUDSDK_CORE_DISABLE_PROMPTS=1
export DEBIAN_FRONTEND=noninteractive
export SUDO_ASKPASS=/bin/false

# Determine directories
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
BASE_DIR="${MAIN_DIR}"

USE_SANDBOX="${USE_SANDBOX:-false}"
for arg in "$@"; do
  if [ "$arg" = "-s" ] || [ "$arg" = "--sandbox" ]; then
    USE_SANDBOX="true"
  fi
done

SANDBOX_OPTS=()
if [ "${USE_SANDBOX}" = "true" ]; then
  SANDBOX_OPTS=("-s")
fi

if ! command -v gemini >/dev/null 2>&1; then
  echo "Error: gemini executable not found in PATH." >&2
  exit 1
fi

# Phase 2 → Phase 3 Gate: Refuse to run if cross-test evidence is missing or
# indicates pure infrastructure failure (all FAIL, no PASS).
SUMMARY_FILE="${BASE_DIR}/impl/test_summary.txt"
if [ ! -f "${SUMMARY_FILE}" ] || [ ! -s "${SUMMARY_FILE}" ]; then
  echo "Error: Phase 2→3 gate failed: impl/test_summary.txt is missing or empty." >&2
  echo "       Run ./tools/run_cross first to generate cross-implementation test evidence." >&2
  exit 1
fi

PASS_COUNT=$(grep -c ': PASS' "${SUMMARY_FILE}" 2>/dev/null || true)
# Check if there is any evidence of fatal upstream specs or tooling defects in the logs
UPSTREAM_DEFECT_DETECTED=0
if grep -r -q -E "Unknown iotProvider jwt|the UDMI spec is broken" out/ impl/logs/ 2>/dev/null; then
  UPSTREAM_DEFECT_DETECTED=1
fi

if [ "${PASS_COUNT}" -eq 0 ] && [ "${UPSTREAM_DEFECT_DETECTED}" -eq 0 ]; then
  echo "Error: Phase 2→3 gate failed: impl/test_summary.txt contains no PASS entries." >&2
  echo "       All pairings failed, indicating infrastructure failure rather than spec issues." >&2
  echo "       The merger agent cannot distinguish genuine interop defects from environmental failures." >&2
  exit 1
fi

GEMINI_BIN="gemini"
GEMINI_OPTS=("--proxy=false" "--approval-mode" "yolo")

IMPL_TIME="${IMPL_TIME:-20}" # Default robust timeout limit

# Run the Gemini Merger Workflow (@MERGER.md)
echo "=== Running Gemini Merger (@MERGER.md) ==="
START_MERGER=$SECONDS
cd "${BASE_DIR}"
echo "Executing gemini ${SANDBOX_OPTS[*]} -p @MERGER.md..."
LOG_FILE_MERGER="${BASE_DIR}/merger.log"
echo "Logging output to ${LOG_FILE_MERGER}..."

# Execute Gemini merger with a timeout to prevent infinite hangs
if timeout ${IMPL_TIME}m "${GEMINI_BIN}" "${GEMINI_OPTS[@]}" "${SANDBOX_OPTS[@]}" -p @MERGER.md < /dev/null > "${LOG_FILE_MERGER}" 2>&1; then
  echo "SUCCESS: Gemini merger run completed successfully."
else
  RET=$?
  if [ "${RET}" -eq 124 ]; then
    echo "FAILURE: Gemini merger run timed out after ${IMPL_TIME} minutes. Check log: ${LOG_FILE_MERGER}"
  else
    echo "FAILURE: Gemini merger run failed with exit code ${RET}. Check log: ${LOG_FILE_MERGER}"
  fi
  exit 1
fi

ELAPSED_MERGER=$(( SECONDS - START_MERGER ))
echo "=== Gemini Merger completed in ${ELAPSED_MERGER}s ==="
